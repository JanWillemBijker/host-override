{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.6.0",
  "description": "__MSG_extDesc__",
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "webRequest",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8899/*",
    "https://cloudflare-dns.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Host Override",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Host Override aan of uit"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed",
  "default_locale": "en",
  "side_panel": {
    "default_path": "popup.html"
  }
}
